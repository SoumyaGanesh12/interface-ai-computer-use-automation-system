# Copy to .env and fill in. .env is gitignored and must never be committed.

# Required only by `npm run discover`. Every other command runs with no key at all.
GEMINI_API_KEY=

# The OpenAI-compatible endpoint and model id. No default is baked into src/ -- these
# are read as required config so swapping providers is purely an env change.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL_ID=gemini-3.5-flash-lite

# Optional tuning knobs; sensible defaults apply if omitted.
GEMINI_MAX_TOKENS=2048
GEMINI_MAX_TOKENS_PER_RUN=80000

# The fixture's own login credentials (synthetic, see fixture/data.ts). Used by
# `npm run discover` to log in before handing control to the model.
FIXTURE_OPERATOR_PASSWORD=fixture-only-not-a-real-secret
